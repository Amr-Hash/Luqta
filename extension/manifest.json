{
  "manifest_version": 3,
  "name": "Luqta — Add to wishlist",
  "short_name": "Luqta",
  "version": "1.0.0",
  "description": "Send the current product page to Luqta for on-device extraction and comparison.",
  "default_locale": "en",
  "action": {
    "default_title": "Add to Luqta",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "contextMenus", "storage", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "commands": {
    "add-to-luqta": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Alt+Shift+L"
      },
      "description": "Add current page to Luqta"
    }
  }
}
